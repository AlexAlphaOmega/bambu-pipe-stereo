// Development parameters — not intended for end users
params {
    bambu_path                  = null
    valid_chemistries           = ['10x3v2', '10x3v3', '10x3v4', '10x5v2', '10x5v3', 'visium-v1', 'visium-v2', 'visium-v3', 'visium-v4', 'visium-v5', 'stereoseq']
    valid_technologies          = ['ONT', 'PacBio']
    valid_quantification_modes  = ['no_quant', 'EM', 'EM_clusters']
    save_intermediates          = false
    qfilter_threshold           = 10
    flexiplex_f_5prime          = 8
    flexiplex_f_3prime          = 13
    flexiplex_e                 = 1
    process_by_chromosome       = true
    seurat_dim_single           = 15
    seurat_dim_multi            = 30
    fusion_mode                 = false
    jaffal_ref_dir              = null
    jaffal_code_dir             = "$projectDir/jaffal"
    cellranger_dir              = "/opt/spaceranger-4.0.1/lib/python/cellranger/barcodes"
    // Stereo-seq parameters
    stereoseq_mask              = null      // path to ST_BarcodeMap chip mask (.h5)
    stereoseq_barcode_map       = null      // ST_BarcodeMap binary path (host binary, bind into container)
    stereoseq_ld_library_path   = null      // LD_LIBRARY_PATH for ST_BarcodeMap's bundled libs
    stereoseq_binsize           = "50"      // square bin sizes (comma-separated, e.g. "20,50,100"); bin50 always produced
}
