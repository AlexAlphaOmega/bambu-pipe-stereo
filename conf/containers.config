process {
    // Local .sif files built from the docker-archive tars in this repo.
    // Build them with: singularity build <name>.sif docker-archive://<name>.tar
    withLabel: 'r'                  { container = "$projectDir/bambu-r.sif" }
    withLabel: 'spaceranger'        { container = "$projectDir/chopper.sif" } // placeholder; not needed for stereoseq
    withLabel: 'minimap2_samtools'  { container = "$projectDir/minimap2.sif" }
    withLabel: 'preprocess'         { container = "$projectDir/chopper.sif" }
}